TOKEN=your_bot_token_from_botfather

# MongoDB (Atlas or self-hosted). Example:
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=
# Database name (collections: users, player_stats, matches, point_ledger)
MONGO_DB_NAME=uno_bot

# Ops / audit log group (optional). JSON events + deploy notices are sent here.
LOG_GROUP_ID=-1003233311003
# LOG_TELEGRAM_ENABLED=true

# Skip / turn grace (group games): how long others wait before /skip; penalty per forced skip while grace remains.
# WAITING_TIME=30
# TIME_REMOVAL_AFTER_SKIP=5
# MIN_FAST_TURN_TIME=15

# Scoring & season: defaults are in config.py (DEFAULT_*). Uncomment only to override:
# STATS_SEASON_ID=2026q1
# WIN_POINTS=120
# PARTICIPATION_POINTS=25
# SECOND_PLACE_POINTS=45
# THIRD_PLACE_POINTS=30
# STREAK_BONUS_3=15
# STREAK_BONUS_5=35
# LARGE_MATCH_BONUS=20
# LARGE_MATCH_MIN_PLAYERS=5
# ABANDON_PENALTY=40
# MIN_VALID_PLAYERS_FOR_POINTS=2
# MIN_VALID_TURNS_FOR_POINTS=4
