# Example systemd unit — copy to /etc/systemd/system/unobot.service and adjust paths/user.
#
#   sudo cp deploy/unobot.service.example /etc/systemd/system/unobot.service
#   sudo nano /etc/systemd/system/unobot.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now unobot
#
[Unit]
Description=Telegram UNO bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_LINUX_USER
WorkingDirectory=/path/to/uno-bot
# Use the venv Python directly (recommended):
ExecStart=/path/to/uno-bot/.venv/bin/python -u /path/to/uno-bot/bot.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
